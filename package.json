{
  "name": "@x-mug/dsh-auto-review-cache-identity",
  "version": "1.1.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/x-mug/dsh-auto-review-cache-identity.git"
  },
  "type": "module",
  "description": "Stable auto-review identity and native Anthropic cache breakpoints, including Desktop Request transport.",
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "*",
    "dsh-session-header": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "dsh-session-header": {
      "optional": true
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "test/*.test.mjs",
    "locale/*.json",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
